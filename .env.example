# Deployment mode: "local" or "cloud"
DEPLOYMENT_MODE=local

# Required for cloud mode: your domain pointing to this server
# DOMAIN=mcp.yourdomain.com

# Required: shared secret between bridge and MCP server
# In cloud mode must be at least 32 characters
# Generate with: openssl rand -hex 32
BRIDGE_API_KEY=your-secret-key-here

BRIDGE_PORT=3001
MCP_PORT=8000

# --- Storage / media ---
# SQLite database path inside the bridge container (mounted from store_db volume).
STORE_DB_PATH=/data/store.db

# Inbound media size cap (MB). Larger inbound media is rejected on download.
MEDIA_MAX_INBOUND_MB=16
# Outbound media size cap for /send/media (MB).
MEDIA_MAX_OUTBOUND_MB=100
# On-disk media cache cap (MB). LRU evicts past this.
MEDIA_CACHE_MAX_MB=2048
# Cached media older than this many days is purged on next eviction sweep.
MEDIA_CACHE_TTL_DAYS=7
# Max base64-inline response size for /media GET. Larger -> client gets a signed URL.
MEDIA_INLINE_RESPONSE_MB=4

# Idempotency cache TTL (hours). Replay window for write tools' idempotency_key.
IDEMPOTENCY_TTL_HOURS=24
